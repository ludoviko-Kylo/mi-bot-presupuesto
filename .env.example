# =============================================================================
# CONFIGURACIÓN DEL BOT DE PRESUPUESTO PERSONAL - PLANTILLA DE ENTORNO
# =============================================================================

# 1. Token de Telegram (Obligatorio)
# Obtenlo en Telegram enviando /newbot al bot oficial @BotFather:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# 2. Base de Datos en la Nube (PostgreSQL / Supabase / Neon / Render Postgres)
# - Para despliegues en la nube 24/7 (Supabase, Railway o Render):
#   Copia la "URI" o "Connection string" de tu proyecto:
#   Ejemplo Supabase: postgresql://postgres.xxxx:TuPassword@aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
#   Ejemplo Render/Railway: postgresql://postgres:password@host:5432/railway
# - Si dejas DATABASE_URL vacío, la aplicación funcionará localmente con SQLite (presupuesto.db):
DATABASE_URL=

# 3. Moneda por defecto ($, S/., €, MXN, etc.)
DEFAULT_CURRENCY=S/

# 4. Puerto y Host de Red
# En Render y Railway la variable PORT se inyecta automáticamente (ej: 10000 o 8080)
PORT=8000
HOST=0.0.0.0

# 5. URL pública de la aplicación desplegada (Opcional)
# Ejemplo: https://mi-bot-presupuesto.onrender.com
APP_URL=
